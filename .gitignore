# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Flutter Windows build cache (regenerated by `flutter pub get`/`flutter run`,
# contains the Flutter engine DLL - hundreds of MB, never track it).
windows/flutter/ephemeral/

# Python virtual environments for the model-training tooling. Local build
# output only, never part of the app or worth tracking. (Leading slashes
# anchor these to the project root; __pycache__ is left unanchored since it
# can legitimately appear at any depth.)
/.venv/
/.venv__/
__pycache__/

# CCH/ is its own separate git repository (a standalone desktop tool for
# preparing training data), cloned into this project folder for local use.
# It is intentionally excluded here rather than deleted: publish it from its
# own remote if needed, not from this repo.
/CCH/

# Training dataset. Currently contains placeholder/non-husk files (including
# real personal ID data in one image) rather than curated husk photos - do
# not publish. Replace with real, reviewed training data before ever
# tracking this folder.
/dataset/

# Real training photos (immature/mature/overmature) plus their source .zip
# downloads - 3.8GB total, including three individual 500-700MB zips that
# would hard-fail a GitHub push on their own. Kept local only; use Git LFS
# or separate storage if this ever needs to be versioned.
/images/

# Training-pipeline output artifacts written to the project root by
# train_model.py / train_model_internet.py / convert_to_tflite.py, and one-off
# loose model copies. The model the app actually ships is tracked normally
# at assets/model/coconut_husk_quality_model.tflite; these are not it.
# Leading slashes anchor these to the project root only, so they don't also
# match (and accidentally exclude) the real asset copy under assets/model/.
/coconut_husk_quality_model.h5
/coconut_husk_quality_model.tflite
/coconut_husk_quality_working.tflite
/coconut_husk_quality_model_v1_4class_backup.tflite
/demo_v2.tflite
/class_names.txt
/class_names_working.txt
/rejection_config.json
